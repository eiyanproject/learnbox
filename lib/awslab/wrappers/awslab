#!/bin/sh
# `awslab`: manages the sandbox behind `aws`. install.sh links
# /usr/local/bin/awslab here.
here=$(dirname "$(readlink -f "$0")")
lib=$(dirname "$(dirname "$here")")
export LEARNBOX_AWS_VENV="${LEARNBOX_AWS_VENV:-/opt/learnbox-toolchain/aws}"
exec env PYTHONPATH="$lib${PYTHONPATH:+:$PYTHONPATH}" "$LEARNBOX_AWS_VENV/bin/python" -m awslab "$@"
