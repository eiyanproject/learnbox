{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyOurBucket",
      "Effect": "Allow",
      "Principal": "*",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::lb-private-data",
        "arn:aws:s3:::lb-private-data/*"
      ]
    }
  ]
}
