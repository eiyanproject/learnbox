{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyThroughOurEndpoint",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::lb-private-data",
        "arn:aws:s3:::lb-private-data/*"
      ],
      "Condition": {
        "StringNotEquals": { "aws:SourceVpce": "VPCE_ID" }
      }
    }
  ]
}
